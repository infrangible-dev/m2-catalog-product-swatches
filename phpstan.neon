# The configuration and rules of PHPStan for the Magento modules are in the package infrangible/phpstan-magento, which
# the module requires in require-dev. It is installed in the Magento installation next to the module (the checks of the
# workflows and the Anodosys development environment merge require-dev of the module into it).
#
# Run in the cli container of the Anodosys system:
#   cd /var/www/magento && vendor/bin/phpstan analyse -c /var/www/module/phpstan.neon
# Elsewhere, the Magento installation has to be in the directory magento next to the module (as in the checks of the
# workflows), with its path in MAGENTO_ROOT:
#   MAGENTO_ROOT=$(pwd)/../magento ../magento/vendor/bin/phpstan analyse -c phpstan.neon
includes:
    - ../magento/vendor/infrangible/phpstan-magento/magento.neon
parameters:
    paths:
        - src
